OPENROUTER_API_KEY=sk-or-v1-your-key-here
VIDEO_MODEL=bytedance/seedance-2.0-fast
PORT=3100

# --- Render workers (optional; see README "Scaling renders") ---
# Without DATABASE_URL, Shorts / Story stitches / Enhance render inside the web server, as always.
# DATABASE_URL=postgres://user:pass@host:5432/videostudio
# RENDER_JOBS=2              # renders at once (per worker when queued)
# RENDER_MAX_ATTEMPTS=2      # tries per render before it is marked failed
# Shared files between the web service and workers (Cloudflare R2 shown; any S3-compatible bucket works).
# Leave S3_BUCKET unset when web and worker share one disk (local dev).
# S3_BUCKET=video-studio
# R2_ACCOUNT_ID=your-cloudflare-account-id     # or S3_ENDPOINT=https://...
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
