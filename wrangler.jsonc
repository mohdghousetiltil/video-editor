// Frontend Worker: serves ./public, asks for the site password, and proxies /api/* to Railway (see worker.js).
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "video-editor",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Not secret, so it lives here and can't go missing. PROXY_KEY (and APP_PASSWORD if wanted) are set as
  // runtime *secrets* in the dashboard: Worker > Settings > Variables and secrets (not the Build variables).
  "vars": {
    "BACKEND_URL": "https://video-editor-production-f2643903.up.railway.app"
  },
  // gives worker.js this deploy's id, used to version /app.css and /app.js in every page
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // keep other variables set in the dashboard when deploying
  "keep_vars": true,
  // PR / branch previews (`wrangler preview`, run by Workers Builds for non-production branches). There is one
  // backend, so previews use it too: a preview spends the same OpenRouter credit, under the same monthly cap.
  // PROXY_KEY (and APP_PASSWORD) must also be set as secrets for previews in the dashboard, or /api calls get 401.
  "previews": {
    "vars": {
      "BACKEND_URL": "https://video-editor-production-f2643903.up.railway.app"
    },
    "version_metadata": { "binding": "CF_VERSION_METADATA" }
  }
}
