// Frontend Worker: serves ./public, asks for the site password, and proxies /api/* to Railway (see worker.js).
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "video-editor",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Not secret, so it lives here and can't go missing. PROXY_KEY (and APP_PASSWORD if wanted) are set as
  // runtime *secrets* in the dashboard: Worker > Settings > Variables and secrets (not the Build variables).
  "vars": {
    "BACKEND_URL": "https://video-editor-production-f2643903.up.railway.app"
  },
  // keep other variables set in the dashboard when deploying
  "keep_vars": true
}
